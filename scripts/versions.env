# Pinned inputs for the KITT watch build. Change these deliberately, then rebuild and re-measure.

# llama.cpp engine (MIT). LlamaEngine.swift is written against this revision's
# llama_batch_ext / llama_process API.
LLAMA_CPP_REPO=https://github.com/ggml-org/llama.cpp.git
LLAMA_CPP_REV=af5c58347fdbc2cd19e65b278e81c8f528f8a175

# SmolLM2-135M-Instruct (Apache 2.0), Q4_0 GGUF quantised by bartowski.
# If you change the model, also change the four marked lines in project.yml.
# The watch downloads MODEL_URL and refuses it unless its size and SHA-256 match.
# Candidates already compared off-watch are listed in Eval/RESULTS.md.
MODEL_REPO=bartowski/SmolLM2-135M-Instruct-GGUF
MODEL_REV=09816acd5d99df7be770d85ea30822623dab342c
MODEL_FILE=SmolLM2-135M-Instruct-Q4_0.gguf
MODEL_SHA256=bcc3af2849ad6095af57e9b5cd43775256efdc66e306acb529172f92d0c04b03
MODEL_BYTES=91893088
# Where the watch (and scripts/fetch-model.sh) downloads it. Before an App Store release,
# host a copy you control (a GitHub release on KITTWatch, say) and point this at it.
MODEL_URL=https://huggingface.co/$MODEL_REPO/resolve/$MODEL_REV/$MODEL_FILE

# Guide voices: Kokoro-82M (Apache 2.0) recordings of every guide reply, one optional
# download per voice. scripts/build-voice-packs.sh builds the packs from Voices/narration
# and, with --update, writes their sizes and SHA-256 here and into project.yml. Publish the
# files in Voices/dist at these URLs (scripts/publish-voice-packs.sh) before shipping: the
# watch refuses a pack unless its size and SHA-256 match.
VOICE_BASE_URL=https://github.com/Palvaran/KITTWatch/releases/download/voices-v1
VOICE_HEART_FILE=kitt-voice-heart-v1.kvoice
VOICE_HEART_SHA256=6991c4137dc641e68cb652b4ffce546719dc6ce62b619173840cf62962ed1e33
VOICE_HEART_BYTES=17978201
VOICE_HEART_URL=$VOICE_BASE_URL/$VOICE_HEART_FILE
VOICE_MICHAEL_FILE=kitt-voice-michael-v1.kvoice
VOICE_MICHAEL_SHA256=abfb16f0a480eb5d1794ba0050da4c85ed65b2eb3963b79250a4e1b8280175f4
VOICE_MICHAEL_BYTES=19846337
VOICE_MICHAEL_URL=$VOICE_BASE_URL/$VOICE_MICHAEL_FILE

# Series 5 tops out at watchOS 10. Xcode 27 still debugs on-device for watchOS 10.
WATCHOS_MIN=10.0
